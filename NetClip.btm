@SETLOCAL
@ECHO OFF

REM This is a wrapper for the NetClip.ps1 file.

iff %1 eq help then
  Gosub Help
endiff

iff %# eq 0 then
  Gosub Help
else
  if isdir r:\temp set temp=r:\temp

  REM Change to reflect location of NetClip.ps1 on your system.
  pshell /s "u:\NetClip.ps1  %$"
endiff

ENDLOCAL
quit

:Help
TEXT
USAGE EXAMPLES:
NetClip -FileIn 'r:\stuff.txt'

NetClip -String 'The quick brown fox jumped over the lazy dog.'

NetClip -List 

NetClip -Retrieve 1

NetClip -Retrieve 1 > clip:
ENDTEXT
Return
